{
    "name": "webware/smf-legacy-router",
    "description": "RouterInterface for routing legacy SMF urls to middleware/request handlers.",
    "license": "BSD-3-Clause",
    "keywords": [
        "template",
        "repository",
        "php"
    ],
    "authors": [
        {
            "name": "Joey (aka Tyrsson) Smith",
            "email": "jsmith@webinertia.net",
            "homepage": "https://github.com/tyrsson/smf-legacy-router/discussions",
            "role": "Developer"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.99"
        },
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "require": {
        "mezzio/mezzio-router": "3.13.0"
    },
    "require-dev": {
        "laminas/laminas-diactoros": "3.2.0",
        "laminas/laminas-stratigility": "3.10.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.5.42",
        "roave/security-advisories": "dev-master",
        "webware/coding-standard": "^0.1.0"
    },
    "autoload": {
        "psr-4": {
            "Webware\\Router\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebwareIntegrationTest\\Router\\": "test/integration/",
            "WebwareTestAsset\\Router\\": "test/asset/",
            "WebwareTest\\Router\\": "test/unit/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@sa",
            "@test",
            "@test-integration"
        ],
        "cs-check": "vendor/bin/php-cs-fixer check -v --show-progress=dots --stop-on-violation",
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "test": "phpunit --colors=always --testsuite \"unit test\"",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "test-integration": "phpunit --colors=always --testsuite \"integration test\"",
        "sa": "vendor/bin/phpstan analyse --memory-limit=256M",
        "sa-gen-baseline": "vendor/bin/phpstan analyse --memory-limit=256M --generate-baseline",
        "sa-verbose": "vendor/bin/phpstan analyse --memory-limit=256M -vv",
        "upload-coverage": "coveralls -v"
    }
}
